---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Heidelberger SC">
  <main class="hero">
    <h1>Welcome to HSC</h1>
    <p>Die Raute im Herzen</p>
  </main>
</Layout>

<style>
  .hero {
    min-height: calc(100vh - 72px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 24px;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0 0 0.5rem;
  }
  p {
    margin: 0;
    color: #555;
    font-size: 1.2rem;
  }
</style>