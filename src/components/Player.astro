---
const { type = 'man', size = 100 } = Astro.props;
---

<svg
  class="player"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {type === 'man' && (
    <>
      <circle cx="46" cy="16" r="8" />
      <path d="M48 28 L48 58" />
      <path d="M48 36 L32 50" />
      <path d="M48 36 L64 46" />
      <path d="M48 58 L36 86" />
      <path d="M48 58 L66 74 L74 84" />
    </>
  )}

  {type === 'woman' && (
    <>
      <circle cx="46" cy="16" r="8" />
      <path d="M53 12 Q67 12 62 27" />
      <path d="M48 28 L36 60 L60 60 Z" />
      <path d="M44 36 L30 48" />
      <path d="M52 36 L64 46" />
      <path d="M42 60 L36 86" />
      <path d="M54 60 L66 74 L74 84" />
    </>
  )}

  {type === 'child' && (
    <>
      <circle cx="46" cy="36" r="10" />
      <path d="M48 48 L48 70" />
      <path d="M48 54 L34 64" />
      <path d="M48 54 L62 60" />
      <path d="M48 70 L40 90" />
      <path d="M48 70 L62 82 L70 90" />
    </>
  )}

  <!-- football -->
  <circle cx="86" cy="86" r="8" stroke-width="3" />
  <polygon
    points="86,81 90.5,84.5 88.8,89.8 83.2,89.8 81.5,84.5"
    fill="currentColor"
    stroke-width="1"
  />
</svg>