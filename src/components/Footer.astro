---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="inner">
    <p class="copy">© {year} Heidelberger Sport-Club.<br />Alle Rechte vorbehalten.</p>

    <div class="center">
      <h2>Heidelberger Sport-Club</h2>
      <address>Harbigweg 10<br />69124 Heidelberg</address>
    </div>

    <a class="mail" href={`${base}/kontakt`} aria-label="Kontakt">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </svg>
    </a>
  </div>
</footer>

<style>
  .footer {
    background: #2b2b2b;
    color: #fff;
    padding: 14px 24px;
  }

  .inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }

  .copy {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.4;
    color: #fff;
  }

  .center {
    text-align: center;
  }

  h2 {
    margin: 0 0 2px;
    font-size: 1rem;
    color: #fcfe58;
  }

  address {
    font-style: normal;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #fff;
  }

  .mail {
    justify-self: end;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: #fff;
    border: 1.5px solid #fff;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .mail svg {
    width: 18px;
    height: 18px;
  }

  .mail:hover,
  .mail:focus-visible {
    background: #fcfe58;
    border-color: #fcfe58;
    color: #000;
  }

  @media (max-width: 760px) {
    .footer {
      padding: 16px 24px;
    }

    .inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 10px;
    }

    .center {
      order: -1;
    }

    .mail {
      justify-self: center;
    }
  }
</style>