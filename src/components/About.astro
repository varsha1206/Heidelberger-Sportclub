---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="about" id="ueber-uns">
  <div class="inner">
    <div class="text">
      <h2>Über uns</h2>

      <p>
        Der Heidelberger SC ist ein Sportverein im Herzen der Stadt.
      </p>
      <p>
        Der Spaß am Sport steht beim HSC im Vordergrund und ein starkes Ehrenamt
        bildet das Fundament für eine familiäre Gemeinschaft.
      </p>
      <p>
        Unter dem Dach des Heidelberger SC finden sich Sportlerinnen und Sportler
        aus den Sportarten Fußball, Tennis, Tischtennis und Volleyball.
      </p>

      <a class="btn" href={`${base}/mitglied-werden`}>Jetzt Mitglied werden</a>
    </div>

    <div class="media">
      <img src={`${base}/about.png`} alt="Der Heidelberger SC" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .about {
    background: #000;
    color: #fff;
    padding: 96px 24px;
  }

  .inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .text {
  text-align: center;
  max-width: 560px;
  margin: 0 auto;
}

  h2 {
    margin: 0 0 24px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
    color: #fcfe58;
  }

  p {
    margin: 0 0 18px;
    font-size: 1.1rem;
    line-height: 1.7;
    color: #fff;
  }

  .btn {
    display: inline-block;
    margin-top: 14px;
    padding: 14px 32px;
    background: #000;
    color: #fcfe58;
    border: 2px solid #fcfe58;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
  }

  .btn:hover,
  .btn:focus-visible {
    background: #fcfe58;
    color: #000;
  }

  .media {
    background: #111; /* shows if the image is missing */
  }

  .media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 860px) {
    .about {
      padding: 64px 24px;
    }

    .inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>