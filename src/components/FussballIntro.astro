---
import Player from './Player.astro';
---

<section class="intro">
  <div class="intro-inner">
    <div class="icons icons-left">
      <Player type="man" size={120} />
      <Player type="child" size={84} />
    </div>

    <div class="text">
      <p class="eyebrow">Unsere Abteilung</p>
      <h1>Willkommen in der Fußball-Abteilung</h1>
      <span class="divider" aria-hidden="true"></span>
      <p>
        Woche für Woche rennen, passen, schießen und schwitzen wir für den
        Sieg. Dafür trainieren, lernen und üben wir im Training.
      </p>
      <p>
        Unser Wunsch ist es, Sport in einer intakten Gemeinschaft zu betreiben
        und mit Freundinnen und Freunden Zeit beim Fußball zu verbringen. Wenn
        du neu in der Stadt bist, oder mal wieder (Kunst-)Rasenluft schnuppern
        willst, dann komm im Training vorbei!
      </p>
    </div>

    <div class="icons icons-right">
      <Player type="woman" size={120} />
      <Player type="child" size={84} />
    </div>
  </div>
</section>

<style>
  .intro {
    position: relative;
    overflow: hidden;
    background: #000;
    color: #fff;
    padding: 5rem 1.5rem;
  }

  /* pitch markings: centre circle + halfway line */
  .intro::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 460px;
    height: 460px;
    transform: translate(-50%, -50%);
    border: 2px solid rgba(252, 254, 88, 0.12);
    border-radius: 50%;
    pointer-events: none;
  }
  .intro::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(252, 254, 88, 0.12);
    pointer-events: none;
  }

  .intro-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr minmax(0, 640px) 1fr;
    align-items: center;
    gap: 2rem;
  }

  .icons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    color: #fcfe58;
  }
  .icons-left :global(.player:nth-child(2)) {
    transform: translateX(-30px);
  }
  .icons-right :global(.player:nth-child(2)) {
    transform: translateX(30px);
  }
  .icons :global(.player) {
    transition: transform 0.3s ease;
  }
  .icons :global(.player:hover) {
    transform: scale(1.1) rotate(-4deg);
  }

  .text {
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 0.75rem;
    color: #fcfe58;
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    color: #fcfe58;
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    line-height: 1.15;
  }
  .divider {
    display: block;
    width: 80px;
    height: 3px;
    margin: 1.5rem auto;
    background: #fcfe58;
    border-radius: 3px;
  }
  .text p:not(.eyebrow) {
    margin: 0 0 1.1rem;
    font-size: 1.1rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.92);
  }

  @media (max-width: 960px) {
    .intro-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .icons {
      flex-direction: row;
      justify-content: center;
      align-items: flex-end;
      gap: 1.5rem;
    }
    .icons-left :global(.player:nth-child(2)),
    .icons-right :global(.player:nth-child(2)) {
      transform: none;
    }
    .intro::before {
      width: 320px;
      height: 320px;
    }
  }
</style>