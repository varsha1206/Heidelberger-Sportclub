---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const teams = [
  { title: 'Herren', sub: 'Herren I–III', href: '/fussball/herren' },
  { title: 'Damen', sub: 'Damen I, II & Freizeitteam', href: '/fussball/damen' },
  { title: 'Alte Herren', sub: 'Kameradschaft & Kick', href: '/fussball/alte-herren' },
  { title: 'Jugend', sub: 'Unser Nachwuchs', href: '/fussball/jugend' },
];
---

<section class="teams">
  <div class="inner">
    <h2>Unsere Mannschaften</h2>
    <span class="divider" aria-hidden="true"></span>

    <div class="grid">
      {teams.map((t) => (
        <a class="card" href={`${base}${t.href}`}>
          <svg class="ball" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <polygon points="12,7 16.5,10.3 14.8,15.5 9.2,15.5 7.5,10.3" fill="currentColor" />
            <path d="M12 7 V2 M16.5 10.3 L21.3 8.7 M14.8 15.5 L17.8 19.7 M9.2 15.5 L6.2 19.7 M7.5 10.3 L2.7 8.7" />
          </svg>
          <h3>{t.title}</h3>
          <p>{t.sub}</p>
          <span class="more">Mehr erfahren <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .teams {
    padding: 5rem 1.5rem;
    background: repeating-linear-gradient(
      90deg,
      #2e7d32 0,
      #2e7d32 90px,
      #388e3c 90px,
      #388e3c 180px
    );
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
   h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: #fcfe58;
  }
  .divider {
    display: block;
    width: 80px;
    height: 3px;
    margin: 1.25rem auto 3rem;
    background: #fcfe58;
    border-radius: 3px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2.5rem 1.5rem 2rem;
    background: #000;
    color: #fff;
    border: 2px solid #fcfe58;
    border-radius: 18px;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .card:hover,
  .card:focus-visible {
    background: #fcfe58;
    color: #000;
    transform: translateY(-6px);
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.22);
  }

  .ball {
    width: 56px;
    height: 56px;
    color: #fcfe58;
    margin-bottom: 1.25rem;
    transition: color 0.25s ease, transform 0.5s ease;
  }
  .card:hover .ball {
    color: #000;
    transform: rotate(180deg);
  }

  h3 {
    margin: 0 0 0.4rem;
    font-size: 1.5rem;
    color: #fcfe58;
    transition: color 0.25s ease;
  }
  .card:hover h3 {
    color: #000;
  }
  p {
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
    opacity: 0.85;
  }
  .more {
    margin-top: auto;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(252, 254, 88, 0.35);
    width: 100%;
    transition: border-color 0.25s ease;
  }
  .card:hover .more {
    border-color: rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 1060px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>